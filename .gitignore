# LexCorpus .gitignore — v0.2
# Governa o que entra no REPOSITÓRIO (código-fonte).
# NÃO confundir com o CONTRATO §2, que governa onde o LexCorpus ESCREVE em runtime
# (/data/raw/exams/...). Os PDFs coletados são dados no storage compartilhado —
# vivem no SSD, não no Git. Ignorá-los aqui não afeta em nada o caminho de escrita.

# ============================================
# Python
# ============================================
__pycache__/
*.pyc
*.log
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
*.egg-info/
*.egg
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
.installed.cfg
MANIFEST

# Virtual environments
venv/
ENV/
env/
.venv
env.bak/
venv.bak/

# Poetry / Pipenv locks (projeto usa requirements.txt)
poetry.lock
Pipfile.lock

# ============================================
# Scrapy
# ============================================
.scrapy/

# ============================================
# IDE e Editores
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace
.project
.pydevproject
.settings/
*.iml
.classpath

# Emacs autosaves e temporários
\#*\#
.\#*

# ============================================
# Testes
# ============================================
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/
.mypy_cache/
.dmypy.json
dmypy.json
tmp/

# ============================================
# Node.js / Frontend (caso surja um frontend)
# ============================================
npm-debug.log
yarn-error.log
yarn.lock
.next/
node_modules/
.cache/
.parcel-cache
.parcel-cache/

# ============================================
# Arquivos temporários e de sistema
# ============================================
*.tmp
*.temp
*.bak
.~*
Thumbs.db
ehthumbs.db
Desktop.ini
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ============================================
# Segurança (NUNCA versionar credenciais)
# ============================================
*.key
*.pem
*.p12
*.pfx
secrets/
.ssh/
credentials.json
.env
.env.*
!.env.example

# ============================================
# Config local
# ============================================
.local/
.config/
config.local.yml
config.local.yaml
terraform.tfvars

# ============================================
# HTML
# ============================================
# Ignora todos os HTMLs (ex.: contratos renderizados vivem em legado/, já ignorada).
# Se um dia precisar versionar um HTML específico (ex.: frontend/index.html),
# adicione uma exceção logo abaixo:  !frontend/index.html
*.html

# ============================================
# Notebooks
# ============================================
.ipynb_checkpoints/

# ============================================
# Dados — NÃO versionar (são dados, não código)
# ============================================
*.pdf
*.txt
*.csv
*.sql
*.db
*.sqlite
*.sqlite3
*.dump
logs/
*.log.*
backups/
*.backup
*.back
*.old
*.pre-*-backup

# EXCEÇÃO: requirements.txt é código de projeto, não dado.
!requirements.txt

# ============================================
# Storage compartilhado — fora do Git
# ============================================
# /data/ é o storage compartilhado com o LexLearn (volume Docker), provisionado
# pela infra. O LexCorpus escreve em /data/raw/exams/ em runtime (CONTRATO §2),
# mas o conteúdo NÃO é versionado. Barra inicial = só o data/ da raiz do projeto
# (um tests/fixtures/data/ eventual continua versionável).
/data/

# ============================================
# Empacotamento e diretórios fora do versionamento
# ============================================
*.tar.gz
imagens/
legacy/
legado/

# PDFs grandes em docs (usar link externo)
docs/**/*.pdf
