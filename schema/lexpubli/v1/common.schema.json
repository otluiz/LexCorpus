{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lex/lexpubli/events/v1/common.schema.json",
  "title": "Definições comuns dos eventos v1 do ecossistema Lex",
  "description": "Não é um evento: só $defs reutilizados pelos schemas de evento.",
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$",
      "description": "Slug canônico: mesmo algoritmo de lexcorpus.util.slugify e concursos.util.slug_lex."
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "exam_board": {
      "type": "object",
      "required": [
        "slug"
      ],
      "additionalProperties": false,
      "properties": {
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Rótulo humano (opcional nas respostas do LexCorpus)."
        }
      }
    },
    "relation": {
      "type": "string",
      "enum": [
        "current",
        "previous",
        "related"
      ],
      "description": "current = o próprio concurso anunciado; previous = um certame anterior do mesmo órgão; related = mesma banca e mesma carreira, em outro órgão (v1.1, LexPubli ADR-0004 §3)."
    },
    "acquisition_data_base": {
      "type": "object",
      "required": [
        "contest_id",
        "relation"
      ],
      "properties": {
        "contest_id": {
          "$ref": "#/$defs/uuid",
          "description": "contest_id do LexPubli (vem no contest.discovery.created)."
        },
        "relation": {
          "$ref": "#/$defs/relation"
        }
      }
    },
    "ref_slug": {
      "type": "object",
      "required": [
        "slug",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$",
          "description": "Slug canônico, mesmo algoritmo do lexcorpus.util.slugify."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Rótulo humano, como publicado."
        }
      }
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Data ISO 8601 (AAAA-MM-DD)."
    },
    "career": {
      "type": "string",
      "enum": [
        "fiscal",
        "controle",
        "tribunais",
        "juridica",
        "policial",
        "legislativa",
        "bancaria",
        "administrativa",
        "estatais",
        "saude",
        "educacao"
      ],
      "description": "Carreira escolhida pela curadoria do LexPubli (lista fixa, ADR-0004 §2). Valor novo = MINOR, com o consumidor primeiro."
    },
    "contest": {
      "type": "object",
      "description": "O concurso como o LexPubli o publica: base de contest.discovery.created e .updated. Sem additionalProperties aqui: cada evento fecha o objeto.",
      "required": [
        "contest_id",
        "contest_slug",
        "title",
        "organ",
        "exam_board",
        "year",
        "status",
        "positions",
        "page_url"
      ],
      "properties": {
        "contest_id": {
          "type": "string",
          "format": "uuid",
          "description": "ID estável do concurso no LexPubli."
        },
        "contest_slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$",
          "description": "Ex.: sefaz_al_2026. Sugestão de chave para o catálogo do LexCorpus."
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "organ": {
          "$ref": "https://lex/lexpubli/events/v1/common.schema.json#/$defs/ref_slug"
        },
        "exam_board": {
          "oneOf": [
            {
              "$ref": "https://lex/lexpubli/events/v1/common.schema.json#/$defs/ref_slug"
            },
            {
              "type": "null"
            }
          ],
          "description": "null = banca ainda não definida (status aguardando_banca no LexCorpus)."
        },
        "year": {
          "type": "integer",
          "minimum": 2000,
          "maximum": 2100
        },
        "status": {
          "type": "string",
          "enum": [
            "previsto",
            "autorizado",
            "edital_aberto",
            "inscricoes_encerradas",
            "prova_realizada",
            "resultado",
            "encerrado"
          ]
        },
        "career": {
          "oneOf": [
            {
              "$ref": "https://lex/lexpubli/events/v1/common.schema.json#/$defs/career"
            },
            {
              "type": "null"
            }
          ],
          "description": "v1.1. null ou ausente = ainda não definida pela curadoria."
        },
        "exam_date": {
          "oneOf": [
            {
              "$ref": "https://lex/lexpubli/events/v1/common.schema.json#/$defs/date"
            },
            {
              "type": "null"
            }
          ],
          "description": "v1.1. Data da prova; quase sempre sai depois do edital. null ou ausente = não divulgada."
        },
        "positions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "slug",
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "slug": {
                "type": "string",
                "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "vacancies": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "salary": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "description": "Remuneração inicial em BRL."
              }
            }
          }
        },
        "registration": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "start": {
              "oneOf": [
                {
                  "$ref": "https://lex/lexpubli/events/v1/common.schema.json#/$defs/date"
                },
                {
                  "type": "null"
                }
              ]
            },
            "end": {
              "oneOf": [
                {
                  "$ref": "https://lex/lexpubli/events/v1/common.schema.json#/$defs/date"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "edital_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "page_url": {
          "type": "string",
          "format": "uri",
          "description": "Página pública do concurso no LexPubli."
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "description": "Fonte onde a descoberta foi feita."
        }
      }
    }
  }
}
