# LexCorpus — variáveis de ambiente (template)
# Copie para .env e ajuste por ambiente. O .env NÃO é versionado (ver .gitignore)
# e NÃO é carregado automaticamente: vale para o operador (export) e para o
# docker-compose (env_file). Os defaults do settings.py cobrem dev local e Docker.

# --- Storage (onde os PDFs são gravados — contrato §2) -----------------------
# Dev local: aponte para o storage compartilhado do LexLearn (caminho absoluto):
#   LEXCORPUS_FILES_STORE=/home/voce/Workspace/LexLearn/LexLearn-v3/data/raw/exams
# Docker: NÃO defina — o volume é montado em /data/raw/exams (default).
#LEXCORPUS_FILES_STORE=/data/raw/exams

# --- RabbitMQ (publicação de eventos — contrato §6) ---------------------------
# False (ou ausente): modo dev, o evento é gravado em disco (EVENTOS_OUT_DIR).
# True: publica no exchange lexcorpus.events (delivery_mode=2).
#RABBIT_ENABLED=False
# Credenciais de produção entram AQUI (nunca no repo):
#RABBIT_URL=amqp://guest:guest@localhost:5672/

# Pasta dos eventos em modo debug (RABBIT_ENABLED=False).
#EVENTOS_OUT_DIR=eventos_debug

# --- Scheduler (python -m lexcorpus.scheduler) --------------------------------
#LEXCORPUS_WATCHLIST=watchlist.yaml
# No Docker, aponte o estado para o volume /state:
#LEXCORPUS_STATE_FILE=./state/scheduler_state.json

# --- StateStore (memória entre crawls — contrato §6.11) -----------------------
# SQLite que registra o que cada concurso já publicou; é o que faz o re-run
# diário publicar só o delta (e o definitivo arquivar o preliminar).
# No Docker, aponte para o volume /state:
#LEXCORPUS_STATE_DB=./state/lexcorpus_state.db
